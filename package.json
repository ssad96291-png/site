{
  "name": "kilinc-dekarasyon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/production.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:compiled": "node build-server/production.js",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc -b",
    "rights:generate": "node scripts/generate-rights-notices.mjs",
    "rights:check": "node scripts/generate-rights-notices.mjs --check",
    "data:keygen": "tsx server/data-cli.ts keygen",
    "data:backup": "tsx server/data-cli.ts backup",
    "data:restore": "tsx server/data-cli.ts restore",
    "data:export-json": "tsx server/data-cli.ts export-json",
    "predev": "node --import tsx scripts/check-startup.mjs",
    "diagnose": "node --import tsx scripts/check-startup.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
