# Optional first-run administrator configuration. Never commit a real password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-unique-password-with-at-least-12-characters
# PORT=3000
# DATA_DIR=.data
# PUBLIC_ORIGIN=https://your-domain.example
# TRUST_PROXY=1  # Only behind one trusted reverse proxy; keep API port private.
# APP_HOST=0.0.0.0
# SITE_DOMAIN=your-domain.example  # Docker Compose/Caddy HTTPS deployment only.

# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf  # Optional Turkish PDF font override.

# Optional notification adapter. Put actual credentials in secure runtime settings only.
# NOTIFY_WEBHOOK_URL=https://notifications.your-provider.com/send
# NOTIFY_ALLOWED_HOSTS=notifications.your-provider.com
# NOTIFY_WEBHOOK_TOKEN=
